# Copy to .env and fill in. Never commit the real .env.

# --- RPC (Helius free tier by default) ---
# Get a free key at https://dev.helius.xyz -- free tier budget is tracked
# in-process by RpcGateway (see COSTS.md) and this bot alerts at 70% usage.
HELIUS_API_KEY=
# Or set these directly instead of HELIUS_API_KEY (e.g. for QuickNode):
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=...
# HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=...
FAILOVER_RPC_URL=

# --- Wallet (--live / --sweep only -- never required for paper, --observe-only) ---
# Base58 or JSON-array 64-byte secret key (32-byte seed + 32-byte pubkey).
# NEVER use your main wallet's key. NEVER commit this. NEVER paste it
# anywhere but this file. The bot never logs it and the code never prints
# it (see bot/solana_wallet.py). Generate a fresh dedicated one with:
#   python3 -c "
#   from nacl.signing import SigningKey
#   import base58
#   sk = SigningKey.generate()
#   secret = bytes(sk) + bytes(sk.verify_key)
#   print('SOLANA_PRIVATE_KEY=' + base58.b58encode(secret).decode())
#   print('Wallet address (fund this one):', base58.b58encode(bytes(sk.verify_key)).decode())
#   "
# See README.md section 3.1 for the full walkthrough.
SOLANA_PRIVATE_KEY=

# --- Telegram alerts (optional but recommended) ---
# Create a bot with @BotFather, then message it once and read your chat_id
# from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Capital ---
BANKROLL_SOL=0.2

# --- Storage ---
DB_PATH=data/bot.db

# --- pump.fun source (optional) ---
# pump.fun's API is unofficial and occasionally 530s under Cloudflare for
# extended stretches. Its coin-LIST/discovery endpoint has been confirmed
# 530-blocked in production use of this bot, so this now defaults to false.
# Set to true to re-enable if pump.fun's API recovers. DexScreener signals
# and InsiderRadar are unaffected either way.
# ENABLE_PUMPFUN=true

# TokenSafety's graduation/LP-burn lookup hits a DIFFERENT pump.fun
# endpoint (coin-info, not coin-list) and is deliberately controlled
# separately from ENABLE_PUMPFUN above -- turning off dead discovery must
# not also false-reject every pump.fun candidate's safety check. Default
# true; only set to false if the coin-info endpoint itself is confirmed
# dead too.
# ENABLE_PUMPFUN_GRADUATION_LOOKUP=false
